[Unit]
Description=Paperclip orchestrator (Build pipeline safety-net + iteration caps)
After=paperclip.service network-online.target
Wants=paperclip.service network-online.target

[Service]
Type=simple
User=paperclip
Group=paperclip
WorkingDirectory=/home/paperclip
Environment="HOME=/home/paperclip"
Environment="NODE_ENV=production"
Environment="PATH=/home/paperclip/.local/share/npm-global/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PAPERCLIP_API=http://127.0.0.1:3100"
EnvironmentFile=/etc/paperclip/secrets
ExecStart=/usr/bin/node /home/paperclip/services/orchestrator.js
Restart=on-failure
RestartSec=10
StandardOutput=append:/var/log/paperclip-orchestrator.log
StandardError=append:/var/log/paperclip-orchestrator.err
MemoryMax=256M

[Install]
WantedBy=multi-user.target
