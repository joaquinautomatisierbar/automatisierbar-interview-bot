# paperclip orchestrator runtime artifacts
tools/paperclip/.orchestrator-state.json

# walk-in auto-draft runtime artifacts (regenerable; committed fallback is final_script_fallback.md)
tools/walkin/final_script_cache.txt
# NOTE: per-person signature.<name>.html/.txt ARE committed (they're the fallback used when the
# mailbox has no Infomaniak-configured signature). A successful live API fetch overwrites them as
# a cache on the VPS working tree only.
tools/paperclip/.pipeline-events.log

# transient scheduler lock — never commit
.claude/scheduled_tasks.lock

# Deep Library generated vector store — rebuilt via tools/library_ingest.py, rsynced to VPS
references/library/fulltext.db

# Script-Tuner voice session store (customer-PII-adjacent transcripts — never commit)
data/voice_sessions/*
!data/voice_sessions/.gitkeep

# Generated LinkedIn post images (regenerable from Image Spec in Notion)
linkedin_images/

# Juglans Offerten-Generator bundle — deployed via rsync, never git'd (client PII,
# real .env, ~1GB .venv + local GGUF model). Deploy docs live in deploy/juglans-*.md.
offerten-generator/

# vRv discovery tool runtime state (client answers — never commit; survives
# git-pull deploys precisely BECAUSE it is ignored)
data/vrv/
