# Copy to /etc/knowspesen/env on the VPS (root-only: chmod 600). NOT committed.
# systemd loads this via EnvironmentFile= in knowspesen.service.

# --- Core ---
PORT=8083
# Marks this as the KnowSpesen deployment (bare root / -> /spesen). The host-sniff
# in api.py also routes knowspesen.* / spesen.* hosts to /spesen regardless.
KNOWSPESEN_HOME=1
# OWN secret, separate from the cockpit (client data must not share a cookie/secret).
FLASK_SECRET_KEY=change-me-to-a-long-random-string
# X-API-Key for the admin route POST /api/spesen/setup-db (and generic /generate-pdf).
PDF_API_KEY=change-me
# Cockpit password also gates /api/spesen/setup-db via _cockpit_auth_ok (operator only).
COCKPIT_PASSWORD=change-me

# --- Storage (own files, isolated from cockpit) ---
SPESEN_DB_PATH=/srv/knowspesen/data/knowspesen.db
SPESEN_RECEIPT_DIR=/srv/knowspesen/receipts
# Where generated PDF/Excel/ZIP land (ephemeral; regenerable on re-close).
SPESEN_OUTPUT_DIR=/srv/knowspesen/out
# Per-receipt upload cap (MB). Keep <= the Caddy request_body max_size.
SPESEN_MAX_IMAGE_MB=12

# --- OCR (Claude Vision) ---
# Own Anthropic key/budget for the client app. Receipt OCR uses claude-sonnet-4-6.
ANTHROPIC_API_KEY=

# --- Accountant (Gubser Kalt & Partner) — for the month-close email draft ---
# Pre-fills the "send to" of the ready-to-paste mail. The KnowBody still sends it
# themselves via Outlook. Leave blank until the client confirms the address.
SPESEN_ACCOUNTANT_EMAIL=

# --- Per-KnowBody logins ---
# Magic-link tokens are stored in the DB (knowbodies.login_token), not here. Create
# the 6 KnowBodies + tokens via POST /api/spesen/setup-db {"seed_demo": true} for the
# demo, OR seed the real names/emails before go-live (see workflows/knowspesen.md).
# Public URL of the PWA (used in the reminder mail).
KNOWSPESEN_URL=https://knowspesen.automatisierbar.ch/spesen
