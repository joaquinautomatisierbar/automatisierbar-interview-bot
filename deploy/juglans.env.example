# Copy to /etc/juglans/env on the VPS (root-only: chmod 600). NOT committed.
# systemd loads this via EnvironmentFile= in juglans.service.
#
# NOTE: the app's HTTP Basic Auth (login for Busslinger) is enforced by the host
# Caddy, NOT here — see deploy/Caddyfile.juglans (inline user + bcrypt hash).

# --- Storage (own dirs, isolated from cockpit/knowspesen) ---
# DATA_DIR holds drafts/ + custom_positions.csv (the only non-regeneratable data).
# TMP_DIR holds catalog.csv + projects_json/ (seeded once, regeneratable).
DATA_DIR=/srv/juglans/data
TMP_DIR=/srv/juglans/tmp

# --- Claude API (the AI position suggestions) ---
# Metered Anthropic Console key (Tej's key). llm_suggest.py reads ANTHROPIC_API_KEY.
# Model is claude-opus-4-8 (hardcoded in tools/llm_suggest.py).
ANTHROPIC_API_KEY=

# --- Client feedback -> Notion ("Juglans Feedback" DB) ---
# Reuse the operator's Notion integration token (same one cockpit/knowspesen use).
# The integration MUST be connected to the Juglans Feedback DB or writes 404.
NOTION_API_KEY=
JUGLANS_FEEDBACK_DB_ID=

# --- Usage tracking -> Notion ("Juglans Usage" DB) ---
# The app writes DATA_DIR/usage_log.jsonl (best-effort; auto-backed-up because
# juglans-backup.sh tars the whole DATA_DIR). A cron (deploy/juglans-usage-sync.sh,
# hourly 08-21) rolls that log up into one Notion row per day so the operator can
# watch pilot engagement. Reuses NOTION_API_KEY above. If this ID is unset, the
# sync no-ops cleanly (the log still accumulates locally).
JUGLANS_USAGE_DB_ID=

# --- Backup + monitoring (cron; see deploy/juglans-backup.sh) ---
# Nightly online-safe snapshot of DATA_DIR (drafts + custom positions), rotated.
JUGLANS_BACKUP_DIR=/srv/juglans/backups
JUGLANS_BACKUP_KEEP=14
# Operator Telegram (backup failures + optional feedback-backlog alert).
OPERATOR_TELEGRAM_BOT_TOKEN=
OPERATOR_TELEGRAM_CHAT_ID=
