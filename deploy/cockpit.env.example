# Copy to /etc/cockpit/env on the VPS (root-only: chmod 600). NOT committed.
# systemd loads this via EnvironmentFile= in cockpit.service.

# --- Core ---
PORT=8082
FLASK_SECRET_KEY=change-me-to-a-long-random-string
# Existing operator/cockpit password (shared cold-call cockpit); per-person logins land in Phase 2.
COCKPIT_PASSWORD=Operations2026$
# X-API-Key for programmatic/admin routes (e.g. setup-appointments-db).
PDF_API_KEY=change-me

# --- Notion (production integration — must have access to the Leads DB + parent page) ---
NOTION_API_KEY=secret_xxx
# Optional override; defaults to the Interview Datenbank in code.
# NOTION_LEADS_DB_ID=31cbebb0-c2f9-8047-9e9f-fc59851f8a34
# Set AFTER running POST /api/cockpit/setup-appointments-db (returns the id).
COCKPIT_APPOINTMENTS_DB_ID=

# --- Booking calendar (shared "Automatisierbar" Google calendar) ---
# Calendar id whose free/busy gates availability AND where events are created.
COCKPIT_CALENDAR_ID=
# ONE of the following credentials (service account preferred):
#   Service account JSON (raw or base64). Share the calendar with the SA email (Make changes to events).
GOOGLE_SERVICE_ACCOUNT_JSON=
#   ...or a path to an OAuth authorized-user token file.
# GOOGLE_TOKEN_JSON=/etc/cockpit/google_token.json

# --- Booking behaviour (optional; sane defaults in code) ---
# COCKPIT_SLOT_MINUTES=60
# COCKPIT_LEAD_DAYS=1
# COCKPIT_HORIZON_DAYS=21

# --- Team Telegram (new booking → "UNASSIGNED, wer übernimmt?") ---
# Reuses the operator bot token by default; set a dedicated one to override.
OPERATOR_TELEGRAM_BOT_TOKEN=
# COCKPIT_TELEGRAM_BOT_TOKEN=
COCKPIT_TEAM_CHAT_ID=-5026363666

# --- Confirmation email + calendar invite (.ics) via Infomaniak SMTP ---
# One Infomaniak application password authenticates both IMAP and SMTP. Reuses the
# walk-in tool's vars; set the account that may send mail (ideally info@automatisierbar.ch).
INFOMANIAK_IMAP_USER=info@automatisierbar.ch
INFOMANIAK_IMAP_PASSWORD=
# Optional SMTP-specific overrides (default to the IMAP creds above):
# INFOMANIAK_SMTP_USER=
# INFOMANIAK_SMTP_PASSWORD=
INFOMANIAK_SMTP_HOST=mail.infomaniak.com
INFOMANIAK_SMTP_PORT=465
# Visible sender / reply-to / organizer on the confirmation email + invite.
COCKPIT_FROM_EMAIL=info@automatisierbar.ch
COCKPIT_FROM_NAME=Automatisierbar

# --- Optional: require a shared secret on /api/book/confirm (leave blank = public) ---
COCKPIT_BOOK_SECRET=
